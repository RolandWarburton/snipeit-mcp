# --- Required: Snipe-IT connection (API-key mode) ---
SNIPEIT_URL=https://your-snipeit.example.com
SNIPEIT_TOKEN=your-personal-access-token

# --- Deployment: docker compose only (not read by the server) ---
# Compose interpolates this into the Traefik router label; `up` fails if unset.
MCP_DOMAIN=example.com

# --- Transport (optional; defaults to stdio) ---
# MCP_TRANSPORT=stdio            # or: http
# MCP_HOST=127.0.0.1             # http only
# MCP_PORT=8080                  # required when MCP_TRANSPORT=http

# --- Optional: restrict which tools are exposed (comma-separated) ---
# SNIPEIT_ALLOWED_TOOLS=system_info,manage_backups

# --- Optional: OAuth gate (HTTP transport only; see README "Remote access") ---
# Gates the public /mcp endpoint behind an OIDC provider's userinfo endpoint.
# Off by default; when on, MCP_OIDC_ISSUER and MCP_RESOURCE_URL are required.
# MCP_AUTH=true
# MCP_OIDC_ISSUER=https://auth.example.com
# MCP_RESOURCE_URL=https://snipeit-mcp.example.com/mcp
# MCP_OIDC_USERINFO_URL=                 # optional; defaults to ${MCP_OIDC_ISSUER}/userinfo
# MCP_ALLOWED_SUBS=                      # optional; comma-separated sub/email allow-list (else any valid token passes)
#
# Optional: validate tokens LOCALLY as signed JWTs against the issuer's JWKS
# instead of calling userinfo per request (no round-trip; survives brief issuer
# blips; trade-off: revocation only takes effect at token expiry). Opt-in.
# MCP_OIDC_JWKS=true                     # derive JWKS from ${MCP_OIDC_ISSUER}/keys
# MCP_OIDC_JWKS_URL=                     # or set the JWKS endpoint explicitly (overrides the derived one)
# MCP_OIDC_AUDIENCE=snipeit-mcp          # optional; if set, require the JWT `aud` to equal this (the client id)

# --- Optional: `deno task smoke` only ---
# Host-reachable Snipe-IT URL for the live smoke test; the container-internal
# SNIPEIT_URL above is not reachable from the host.
# SNIPEIT_URL_OVERRIDE=https://snipeit.example.com
