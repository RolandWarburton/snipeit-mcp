{
  "name": "snipeit-mcp-deno",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read --allow-write src/main.ts",
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-write src/main.ts",
    "check": "deno check src/main.ts",
    "test": "deno test --allow-read --allow-write --allow-net --allow-env",
    "smoke": "deno run --env-file=.env -A scripts/live-smoke.ts"
  },
  "imports": {
    "@modelcontextprotocol/sdk/": "npm:/@modelcontextprotocol/sdk@1.29.0/",
    "zod": "npm:zod@^3.25.0",
    "jose": "npm:jose@^5",
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "strict": true
  }
}
